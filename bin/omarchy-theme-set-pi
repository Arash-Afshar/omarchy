#!/bin/bash

# omarchy:summary=Sync the generated Omarchy Pi theme
# omarchy:args=[--activate]
# omarchy:hidden=true

set -euo pipefail

CURRENT_THEME_PATH="$HOME/.local/state/omarchy/current/theme"
PI_SOURCE_PATH="$CURRENT_THEME_PATH/pi.json"
PI_THEME_NAME="omarchy-system"
PI_ACTIVATE=0

# Pi reads its whole agent tree from PI_CODING_AGENT_DIR when it is set, and
# expands a leading ~ there itself, so a value from a service or a config file
# may still carry one.
PI_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
if [[ $PI_AGENT_DIR == "~" || $PI_AGENT_DIR == "~/"* ]]; then
  PI_AGENT_DIR="$HOME${PI_AGENT_DIR:1}"
fi
PI_THEME_DIR="$PI_AGENT_DIR/themes"
PI_THEME_PATH="$PI_THEME_DIR/$PI_THEME_NAME.json"
PI_SETTINGS_PATH="$PI_AGENT_DIR/settings.json"

usage() {
  echo "Usage: omarchy-theme-set-pi [--activate]"
}

for arg in "$@"; do
  case "$arg" in
    --activate)
      PI_ACTIVATE=1
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

if [[ ! -f $PI_SOURCE_PATH ]]; then
  if (( PI_ACTIVATE == 1 )); then
    echo "Pi theme source missing: $PI_SOURCE_PATH" >&2
    echo "Run omarchy-theme-refresh after selecting an Omarchy theme." >&2
    exit 1
  fi

  exit 0
fi

if (( PI_ACTIVATE == 0 )) && [[ ! -d $PI_AGENT_DIR ]]; then
  exit 0
fi

# Activation runs on every re-provision. Pi 1.5 writes "system" as its own
# default (follow the terminal). That is not a theme the user picked, so it
# becomes omarchy-system. Any other name, including dark and light, stays.
write_setting_theme() {
  local settings tmp current

  mkdir -p "$PI_AGENT_DIR"

  if [[ ! -e $PI_SETTINGS_PATH ]]; then
    printf '{\n  "theme": "%s"\n}\n' "$PI_THEME_NAME" >"$PI_SETTINGS_PATH"
    return
  fi

  # Write through a symlinked settings file (a dotfiles checkout) rather than
  # replacing the link, and keep the file's own mode.
  settings=$(readlink -f "$PI_SETTINGS_PATH")

  if ! current=$(jq -r 'if type == "object" then (.theme // "") else error("not an object") end' "$settings" 2>/dev/null); then
    echo "Pi settings are not valid JSON, leaving them unchanged: $PI_SETTINGS_PATH" >&2
    return 1
  fi

  # Already ours, or a theme the user picked. "system" is Pi's own default.
  if [[ -n $current && $current != "system" ]]; then
    return
  fi

  tmp=$(mktemp "$settings.XXXXXX")
  if ! { cp -p "$settings" "$tmp" && jq --arg theme "$PI_THEME_NAME" '.theme = $theme' "$settings" >"$tmp" && mv "$tmp" "$settings"; }; then
    rm -f "$tmp"
    echo "Could not update Pi settings: $PI_SETTINGS_PATH" >&2
    return 1
  fi
}

mkdir -p "$PI_THEME_DIR"
tmp=$(mktemp "$PI_THEME_PATH.XXXXXX")
cp "$PI_SOURCE_PATH" "$tmp"
mv "$tmp" "$PI_THEME_PATH"

if (( PI_ACTIVATE == 1 )); then
  write_setting_theme
fi
